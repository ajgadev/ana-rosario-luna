---
import { SITE, SOCIAL_LINKS, type SocialNetwork } from "../../data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Iconos (Simple Icons). Para añadir una red: ampliar SocialNetwork y este mapa.
const ICONS: Record<SocialNetwork, { viewBox: string; path: string }> = {
  linkedin: {
    viewBox: "2.5 2.5 19 19",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z",
  },
};
---

<ul class:list={["flex items-center gap-2.5", className]}>
  {
    SOCIAL_LINKS.map(({ network, label, href }) => (
      <li>
        <a
          href={href}
          target="_blank"
          rel="noopener"
          aria-label={`${label} de ${SITE.name} (se abre en una pestaña nueva)`}
          title={label}
          class="grid size-10 place-items-center rounded-full bg-soft text-primary transition duration-200 hover:-translate-y-px hover:bg-accent hover:text-white"
        >
          <svg class="size-[18px]" viewBox={ICONS[network].viewBox} fill="currentColor" aria-hidden="true">
            <path d={ICONS[network].path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
