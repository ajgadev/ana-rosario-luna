---
import Container from "../ui/Container.astro";
import Star from "../ui/Star.astro";
import { SITE } from "../../data/site";
---

<section class="bg-primary py-[100px] text-center text-bg">
  <Container>
    <figure>
      <Star size={26} class="mx-auto mb-6" />
      <blockquote class="mx-auto max-w-[26ch] font-serif text-[clamp(24px,2.8vw,36px)] font-light leading-[1.3]">
        {SITE.quote}
      </blockquote>
      <figcaption class="mt-7 text-xs font-bold uppercase tracking-[0.16em] text-bg/60">
        — {SITE.name}
      </figcaption>
    </figure>
  </Container>
</section>
