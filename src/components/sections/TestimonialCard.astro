---
import type { Testimonial } from "../../data/testimonials";

type Props = Testimonial;

const { quote, author = "Testimonio anónimo", context } = Astro.props;

// Los testimonios largos se recortan con «Leer más» para no descuadrar la rejilla.
const MAX_CHARS = 220;
const isLong = quote.length > MAX_CHARS;
const quoteId = isLong ? `testimonio-${crypto.randomUUID().slice(0, 8)}` : undefined;
---

<figure class="flex flex-col gap-4 rounded-card bg-bg-alt p-[30px]">
  <div class="flex-1">
    <blockquote id={quoteId} class="font-serif text-lg leading-[1.4] text-primary" data-clamp={isLong || undefined}>
      {quote}
    </blockquote>
    {
      isLong && (
        <button
          type="button"
          class="mt-3 cursor-pointer text-[12.5px] font-bold text-accent underline-offset-4 hover:underline"
          aria-expanded="false"
          aria-controls={quoteId}
          data-read-more
          hidden
        >
          Leer más
        </button>
      )
    }
  </div>
  <figcaption class="border-t border-line pt-3.5 text-[12.5px] text-ink-soft">
    <strong class="block font-bold text-primary">{author}</strong>
    {context}
  </figcaption>
</figure>

<style>
  /* Recorte solo con JS activo: sin JS se lee el testimonio completo. */
  :global(.js) [data-clamp]:not([data-expanded]) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    overflow: hidden;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-read-more]").forEach((button) => {
    const quote = document.getElementById(button.getAttribute("aria-controls")!);
    if (!quote) return;
    button.hidden = false;

    button.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      quote.toggleAttribute("data-expanded", !expanded);
      button.setAttribute("aria-expanded", String(!expanded));
      button.textContent = expanded ? "Leer más" : "Leer menos";
    });
  });
</script>
