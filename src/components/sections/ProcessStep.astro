---
import type { ProcessStep } from "../../data/process";

interface Props extends ProcessStep {
  step: number;
}

const { step, title, description } = Astro.props;
---

<li class="flex flex-col items-center gap-3 rounded-card border border-line bg-bg px-7 py-8 text-center">
  <span class="grid size-[52px] place-items-center rounded-full bg-soft font-serif text-xl text-primary" aria-hidden="true">
    {step}
  </span>
  <h3>{title}</h3>
  <p class="max-w-[28ch] text-[15px]">{description}</p>
</li>
