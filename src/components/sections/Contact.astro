---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Kicker from "../ui/Kicker.astro";
import Star from "../ui/Star.astro";
import ContactLinks from "../ui/ContactLinks.astro";
import SocialLinks from "../ui/SocialLinks.astro";
import ContactForm from "./ContactForm.astro";
import { SITE } from "../../data/site";
---

<section id="contacto" aria-labelledby="contacto-title" class="py-[72px] text-center md:py-[120px]">
  <Container>
    <Star size={28} class="mx-auto mb-5" />
    <Kicker>Contacto</Kicker>
    <h2 id="contacto-title" class="mx-auto mt-3 max-w-[16ch]">Da el primer paso.</h2>
    <p class="mx-auto mt-5 max-w-[44ch] leading-[1.6]">
      Escríbeme por email o WhatsApp y coordinamos tu primera sesión virtual.
    </p>

    <ContactLinks class="mt-9 text-[15px]" />

    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <Button href={`mailto:${SITE.email}`}>Enviar email</Button>
      <Button href={SITE.whatsapp.url} variant="outline" target="_blank" rel="noopener">
        Escribir por WhatsApp
      </Button>
    </div>

    <SocialLinks class="mt-7 justify-center" />

    <ContactForm />
  </Container>
</section>
