---
import { Image } from "astro:assets";
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import portrait from "../../assets/ana-portrait.jpeg";
import { SITE } from "../../data/site";

const meta = [
  { label: "Modalidad", value: "100% online" },
  { label: "Atiende a", value: "Adolescentes y adultos" },
];
---

<Section id="sobre" aria-labelledby="sobre-title">
  <Container class="reveal grid items-center gap-10 min-[881px]:grid-cols-[.9fr_1.1fr] min-[881px]:gap-16">
    <div class="relative aspect-[4/5] overflow-hidden rounded-card border border-line bg-[linear-gradient(160deg,var(--color-bg-alt),var(--color-soft))]">
      <Image
        src={portrait}
        alt={`${SITE.name}, psicóloga sanitaria`}
        class="absolute inset-0 size-full object-cover object-[50%_10%]"
        widths={[400, 600, 900]}
        sizes="(max-width: 880px) 100vw, 470px"
      />
    </div>

    <div class="[&_p]:max-w-[52ch] [&_p]:text-[17px] [&_p]:leading-[1.7]">
      <SectionHeading id="sobre-title" kicker="Sobre mí" title="Un espacio virtual, <br>tan real como cualquier otro." />
      <p class="mt-5">
        Soy {SITE.name}, psicóloga general sanitaria. Acompaño a adolescentes y adultos en procesos
        de ansiedad, autoestima y momentos de cambio — siempre en sesiones virtuales, desde donde estés.
      </p>
      <blockquote class="my-8 max-w-[44ch] rounded-[20px] bg-soft p-6 font-serif text-[21px] leading-[1.4] text-primary">
        {SITE.quote}
      </blockquote>
      <p>
        Trabajo con un enfoque cercano y práctico, adaptado a cada etapa de la vida — desde la
        adolescencia hasta la adultez.
      </p>
      <dl class="mt-7 flex flex-wrap gap-7">
        {
          meta.map((item) => (
            <div class="text-xs uppercase tracking-[0.04em] text-ink-soft">
              <dt>{item.label}</dt>
              <dd class="mt-1 font-serif text-[19px] normal-case tracking-normal text-primary">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Container>
</Section>
