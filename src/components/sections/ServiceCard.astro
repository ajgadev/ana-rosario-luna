---
import Star from "../ui/Star.astro";
import type { Service } from "../../data/services";

type Props = Service;

const { title, description } = Astro.props;
---

<article
  class="flex min-h-[220px] flex-col gap-3.5 rounded-card border border-line bg-bg px-7 py-8 transition duration-300 hover:-translate-y-[3px] hover:shadow-[0_20px_40px_-26px_rgba(94,79,126,0.25)]"
>
  <Star size={18} />
  <h3>{title}</h3>
  <p class="flex-1 text-[14.5px] leading-[1.6]">{description}</p>
  <a
    href="#contacto"
    class="flex items-center justify-between border-t border-line pt-3.5 text-[12.5px] font-bold text-accent"
  >
    <span>Saber más</span><span aria-hidden="true">→</span>
  </a>
</article>
